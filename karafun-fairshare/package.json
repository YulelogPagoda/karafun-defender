{
  "name": "karafun-fairshare",
  "version": "0.1.0",
  "private": true,
  "description": "Fair-share queue scheduler that sits in front of a KaraFun player (observe-mode scaffold).",
  "main": "server.js",
  "scripts": {
    "start": "OBSERVE=1 node server.js",
    "observe": "OBSERVE=1 node server.js",
    "live": "OBSERVE=0 node server.js",
    "proxy": "OBSERVE=1 MODE=proxy node server.js",
    "test": "node --test",
    "probe": "node ../karafun-probe.js",
    "topology": "node ../karafun-topology.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.2",
    "http-proxy": "^1.18.1",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  }
}
